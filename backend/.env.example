# -----------------------------------------------------------------------------
# AgentOps — Abyssal Intelligence Backend Configuration
# Copy this file to .env and customize values for your local environment:
# cp .env.example .env
# -----------------------------------------------------------------------------

# Application Information
PROJECT_NAME="AgentOps API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Server Network Settings
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins
# Comma-separated list of origins allowed to make requests to the API
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# MongoDB Connectivity
# Leave MONGODB_URI empty if MongoDB is not installed or configured yet.
# The /api/v1/health/database endpoint will accurately report 'not_configured'.
# Example local URI: mongodb://localhost:27017
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
DATABASE_NAME="agentops_abyssal"

# Security & Authentication (JWT & Password Hashing tokens)
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
